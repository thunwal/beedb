POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Dropbox (used by scripts/backup.sh)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_FOLDER=/beedb-backups

# Mail notifications (used by scripts/backup.sh; requires ssmtp configured)
# Leave BACKUP_MAIL_TO empty to disable mail.
BACKUP_MAIL_FROM=
BACKUP_MAIL_TO=
